# Create a Desktop OAuth client in Google Cloud, then copy its values here.
GOOGLE_TASKS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_TASKS_CLIENT_SECRET=your-client-secret
# This must exactly match a redirect URI configured in Google Cloud.
GOOGLE_TASKS_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
# Optional. Defaults to %APPDATA%\\codex-google-tasks\\token.json on Windows.
# GOOGLE_TASKS_TOKEN_PATH=C:\\secure-folder\\google-tasks-token.json
