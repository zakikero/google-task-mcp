# Create a Desktop OAuth client in Google Cloud, then copy its values here.
GOOGLE_TASKS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_TASKS_CLIENT_SECRET=your-client-secret
# Keep this local. The default works with Google's Desktop app OAuth client.
GOOGLE_TASKS_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback
# Optional. Defaults to %APPDATA%\\google-task-mcp\\token.json on Windows or
# ~/.config/google-task-mcp/token.json on macOS and Linux.
# GOOGLE_TASKS_TOKEN_PATH=C:\\secure-folder\\google-task-mcp-token.json
